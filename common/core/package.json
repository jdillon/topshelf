{
  "name": "@topshelf/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@topshelf/eslint-config": "workspace:*",
    "@topshelf/typescript-config": "workspace:*",
    "eslint": "^9.28.0",
    "typescript": "^5.8.0"
  }
}
