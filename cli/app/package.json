{
  "name": "@topshelf/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "topshelf": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build src/cli.ts --outdir=dist --target=bun",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@topshelf/core": "workspace:*",
    "@topshelf/plugins": "workspace:*",
    "commander": "^14.0.0"
  },
  "devDependencies": {
    "@topshelf/eslint-config": "workspace:*",
    "@topshelf/typescript-config": "workspace:*",
    "eslint": "^9.28.0",
    "typescript": "^5.8.0"
  }
}
